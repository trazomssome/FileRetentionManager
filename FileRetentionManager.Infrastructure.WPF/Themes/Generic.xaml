<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FileRetentionManager.Infrastructure.WPF.Controls">
    <Style TargetType="{x:Type controls:DeletionConfirmationControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DeletionConfirmationControl}">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Start retention sequence"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="{Binding Request.FileCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0} files match the active retention conditions for the first run.'}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,20,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold"
                                       Text="First run preview" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                       Text="{Binding Request.TotalBytes, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:N0} bytes'}" />
                        </Grid>

                        <ListView Grid.Row="2"
                                  MinHeight="260"
                                  ItemsSource="{Binding Request.Files, RelativeSource={RelativeSource TemplatedParent}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="190" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Size" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Length, StringFormat='{}{0:N0} bytes'}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Last modified (UTC)" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastWriteTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Path" Width="260" DisplayMemberBinding="{Binding Path}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <DockPanel Grid.Row="3" Margin="0,20,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       Text="Later scheduled runs will delete matching files without another prompt." />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button MinWidth="96"
                                        Margin="0,0,8,0"
                                        Command="{TemplateBinding CancelCommand}"
                                        Content="Cancel" />
                                <Button MinWidth="128"
                                        Command="{TemplateBinding ConfirmCommand}"
                                        Content="Start sequence" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
